# À renseigner lorsque la base MySQL Hostinger sera créée.
DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=
# Facultatif : chemin du fichier PHP privé qui retourne les paramètres DB_*.
# L'API cherche d'abord ../avis-communaute.config.php, à côté de public_html,
# puis api/avis-communaute.config.php, protégé par .htaccess pour un compte FTP limité.
AVIS_DB_CONFIG=
