# À renseigner lorsque la base MySQL Hostinger sera créée.
DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=
# Facultatif : chemin du fichier PHP privé qui retourne les paramètres DB_*.
# En production, le chemin par défaut est ../avis-communaute.config.php,
# à côté de public_html, jamais dedans.
AVIS_DB_CONFIG=
